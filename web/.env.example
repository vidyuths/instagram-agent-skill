# Password for the single login.
APP_PASSWORD=
# Signs the session cookie. At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=
# Optional. Where the skills folder lives (defaults to ../skills in dev, /app/skills in Docker).
# SKILLS_DIR=
# Optional. Python interpreter used to run the tools.
# PYTHON_BIN=python3
# Studio: your Anthropic API key. Server-side only, never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional. Where the SQLite file (voice profile, saved drafts) lives. Mount a volume here.
# DATA_DIR=/data
